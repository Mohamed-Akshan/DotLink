# Copy this file to .env in the root dotlink folder.
# Change the PostgreSQL password and generate your own secret.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/dotlink
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Colombo

# At least one provider is needed for Dottie. Manual CRUD works without AI keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Langfuse. Enabling traces sends conversation and tool data to your instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Required only for Docker Compose; use a URL-safe password.
POSTGRES_PASSWORD=
